<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />
    <queries><package android:name="com.google.android.apps.healthdata" /></queries>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:label="Thalpos Sleep" android:allowBackup="false" android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".PrivacyActivity" android:exported="true">
            <intent-filter><action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" /></intent-filter>
        </activity>
        <activity-alias android:name="ViewPermissionUsageActivity" android:exported="true"
            android:targetActivity=".PrivacyActivity" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name="HealthOnboarding" android:exported="true"
            android:targetActivity=".MainActivity" android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
            <intent-filter><action android:name="androidx.health.ACTION_SHOW_ONBOARDING" /></intent-filter>
        </activity-alias>
        <activity-alias android:name="PlatformHealthOnboarding" android:exported="true"
            android:targetActivity=".MainActivity" android:permission="android.permission.health.START_ONBOARDING">
            <intent-filter><action android:name="android.health.connect.action.SHOW_ONBOARDING" /></intent-filter>
        </activity-alias>
    </application>
</manifest>
